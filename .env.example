# Copy this file to .env and fill it in. .env is not committed.

# The Firebase project (Google sign-in, notifications, the live board): Firebase console →
# Project settings → General → Your apps → Web app → SDK setup and configuration.
# Required: the app won't start, and the build fails, without them. They are not secrets
# (they ship in the page); restrict the key to your domains in Google Cloud → Credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The Web Push key pair for lunch notifications: Firebase console → Project settings →
# Cloud Messaging → Web Push certificates → Generate key pair, then paste the public key.
# Without it the app simply hides the notification switch.
VITE_FIREBASE_VAPID_KEY=

# Where the Lunch Club MCP server lives (shown on the Connect AI assistant page).
# Defaults to https://lunchclub-mcp.vercel.app/mcp.
# VITE_MCP_URL=https://lunchclub-mcp.vercel.app/mcp

# The live board: listen to each lunch's Firestore copy so changes show at once instead of every 15s.
# Turn on only after the backend runs with FIRESTORE_ENABLED=true and firestore.rules is deployed
# (firebase deploy --only firestore:rules from lunch-backend).
VITE_LIVE_BOARD=True
