 "cues": {
  "n1": {
   "s": 0.985,
   "e": 3.811,
   "text": "Every day at noon, thirty-five people get hungry.",
   "voice": "af_heart",
   "narrator": true
  },
  "n2a": {
   "s": 4.254,
   "e": 4.796,
   "text": "Veg.",
   "voice": "af_heart",
   "narrator": true
  },
  "n2b": {
   "s": 4.944,
   "e": 5.553,
   "text": "Pizza.",
   "voice": "af_heart",
   "narrator": true
  },
  "n2c": {
   "s": 5.701,
   "e": 6.347,
   "text": "Burgers.",
   "voice": "af_heart",
   "narrator": true
  },
  "n2d": {
   "s": 6.692,
   "e": 8.3,
   "text": "Everyone wants something different.",
   "voice": "af_heart",
   "narrator": true
  },
  "n3": {
   "s": 9.088,
   "e": 11.637,
   "text": "So, one person becomes the organiser.",
   "voice": "af_heart",
   "narrator": true
  },
  "n4": {
   "s": 11.982,
   "e": 14.671,
   "text": "They pass their phone round, so everyone can pick.",
   "voice": "af_heart",
   "narrator": true
  },
  "c1": {
   "s": 15.262,
   "e": 16.879,
   "text": "A paneer roll for me, please.",
   "voice": "bf_emma",
   "narrator": false
  },
  "c2": {
   "s": 17.47,
   "e": 18.817,
   "text": "Is the biryani veg?",
   "voice": "am_michael",
   "narrator": false
  },
  "c3": {
   "s": 19.408,
   "e": 20.527,
   "text": "No onions, please.",
   "voice": "am_fenrir",
   "narrator": false
  },
  "c4": {
   "s": 21.118,
   "e": 22.345,
   "text": "Wait, what are you getting?",
   "voice": "bm_george",
   "narrator": false
  },
  "n4b": {
   "s": 22.936,
   "e": 25.664,
   "text": "And on and on, until all thirty-five have picked.",
   "voice": "af_heart",
   "narrator": true
  },
  "n5": {
   "s": 26.452,
   "e": 29.332,
   "text": "Then they order by hand, one restaurant at a time.",
   "voice": "af_heart",
   "narrator": true
  },
  "n6": {
   "s": 30.317,
   "e": 32.657,
   "text": "It takes a few hours. Every single day.",
   "voice": "af_heart",
   "narrator": true
  },
  "n7a": {
   "s": 34.332,
   "e": 35.443,
   "text": "Thirty-five people.",
   "voice": "af_heart",
   "narrator": true
  },
  "n7b": {
   "s": 35.738,
   "e": 36.734,
   "text": "One organiser.",
   "voice": "af_heart",
   "narrator": true
  },
  "n7c": {
   "s": 37.03,
   "e": 38.053,
   "text": "Orders by hand.",
   "voice": "af_heart",
   "narrator": true
  },
  "n8a": {
   "s": 39.038,
   "e": 42.95,
   "text": "Swiggy's group order shares one cart, but only from one restaurant.",
   "voice": "af_heart",
   "narrator": true
  },
  "n8b": {
   "s": 43.443,
   "e": 46.991,
   "text": "And its multi-restaurant checkout is still one person's cart.",
   "voice": "af_heart",
   "narrator": true
  },
  "n9": {
   "s": 47.976,
   "e": 49.038,
   "text": "Meet Lunch Board.",
   "voice": "af_heart",
   "narrator": true
  },
  "n10": {
   "s": 50.515,
   "e": 53.101,
   "text": "Everyone picks their own lunch, from any restaurant.",
   "voice": "af_heart",
   "narrator": true
  },
  "n11": {
   "s": 53.791,
   "e": 55.692,
   "text": "The app groups the picks by restaurant.",
   "voice": "af_heart",
   "narrator": true
  },
  "n12": {
   "s": 56.382,
   "e": 59.303,
   "text": "The host taps confirm, and the app places the order.",
   "voice": "af_heart",
   "narrator": true
  },
  "n13": {
   "s": 60.583,
   "e": 63.136,
   "text": "From a few hours a day, to about five minutes.",
   "voice": "af_heart",
   "narrator": true
  },
  "n15": {
   "s": 64.515,
   "e": 69.184,
   "text": "Coming soon: add menus from local places, even ones that aren't on Swiggy.",
   "voice": "af_heart",
   "narrator": true
  },
  "n14": {
   "s": 70.268,
   "e": 72.8,
   "text": "Lunch Board. Everyone picks. One order.",
   "voice": "af_heart",
   "narrator": true
  }
 },
